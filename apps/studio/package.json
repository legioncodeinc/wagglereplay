{
  "name": "@waggle/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local SvelteKit 5 studio editor: film strip, step detail, description authoring, heatmap overlay, and project settings over a Waggle project directory (prd-005). Launched by `waggle studio` / `waggle record`.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "e2e": "tsx test/e2e/run-studio-smoke.ts"
  },
  "dependencies": {
    "@waggle/compose": "workspace:*",
    "@waggle/ingest": "workspace:*",
    "@waggle/ir": "workspace:*",
    "@waggle/narrate": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
