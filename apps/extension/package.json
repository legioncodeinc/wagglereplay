{
  "name": "@waggle/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 capture extension: tabCapture screencast plus click/route/element telemetry, streamed to the local Studio server.",
  "exports": {
    ".": "./src/index.ts"
