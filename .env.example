# Waggle configuration. Copy to .env and fill in real values.
# .env is gitignored; this file documents every variable Waggle reads.
# Secrets NEVER go into walkthrough project files (ADR-008): only env refs.

# ---- Voice / narration (ADR-006) ----
# Default TTS provider. One of: elevenlabs | deepgram | xai
WAGGLE_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=replace-me
# Optional budget adapter (no native timestamps; alignment pass required)
DEEPGRAM_API_KEY=
# Optional watch-list adapter
XAI_API_KEY=

# ---- Script generation LLM ----
# Any OpenAI-compatible or Anthropic endpoint; used to draft narration scripts.
WAGGLE_SCRIPT_MODEL=claude-sonnet-latest
ANTHROPIC_API_KEY=replace-me

# ---- Vision QA (prd-011, optional) ----
GEMINI_API_KEY=

# ---- Replay (prd-009) ----
# Max parallel render jobs on this machine.
WAGGLE_RENDER_CONCURRENCY=2

# ---- Walkthrough credentials (prd-010) ----
# credentials.json stores ONLY these environment-variable names. Put the
# corresponding real values in a local, gitignored .env file and load that
# file into the Waggle process. Leave them blank in this committed example.
DEMO_USER=
DEMO_PASSWORD=
DEMO_TOTP_SEED=

# ---- Optional cloud runner (ADR-014, off by default) ----
# Only needed when using the Cloudflare runner profile for CI regeneration.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
